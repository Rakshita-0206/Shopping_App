datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id            String         @id
  name          String
  slug          String         @unique
  category      String
  categoryName  String
  subcategory   String
  price         Float
  originalPrice Float?
  mrp           Float?
  discountPct   Float?
  fabric        String?
  description   String
  artisanStory  String
  fabricAndCare String         // JSON encoded string array
  shippingInfo  String
  tag           String?
  inStock       Boolean        @default(true)
  rating        Float          @default(4.5)
  reviewsCount  Int            @default(0)
  isFeatured    Boolean        @default(false)
  isNew         Boolean        @default(false)
  isSale        Boolean        @default(false)
  sizes         String         // JSON encoded string array
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  images        ProductImage[]
  colors        ProductColor[]
  orderItems    OrderItem[]
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  isPrimary Boolean  @default(false)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductColor {
  id        String   @id @default(cuid())
  name      String
  hex       String
  image     String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id            String   @id
  name          String
  slug          String   @unique
  description   String
  bannerImage   String
  featuredImage String
  featuredTitle String
  subcategories String   // JSON encoded subcategory groups
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id             String      @id // e.g. FAB-829103
  fullName       String
  email          String
  phone          String
  address        String
  city           String
  state          String
  pincode        String
  subtotal       Float
  discount       Float       @default(0)
  shippingFee    Float       @default(0)
  total          Float
  paymentMethod  String      // "upi" | "card" | "cod"
  paymentStatus  String      @default("paid")
  orderStatus    String      @default("confirmed")
  couponCode     String?
  fabcoinsUsed   Int         @default(0)
  fabcoinsEarned Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items          OrderItem[]
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productImage String
  size         String
  color        String
  quantity     Int
  price        Float
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Float
  minOrderValue   Float    @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}
